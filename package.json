{
  "name": "gmp-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install": "npm install --workspaces",
    "build": "cd apps/gmp-api && npm run build",
    "start": "cd apps/gmp-api && npm run start",
    "start:dev": "cd apps/gmp-api && npm run start:dev",
    "start:prod": "cd apps/gmp-api && npm run start:prod",
    "lint": "cd apps/gmp-api && npm run lint"
  }
}
