# Application
NODE_ENV=development
PORT_API=3007
PORT_BATCH=4000
API_URL=http://localhost:3007

# Database
MONGO_DEV=mongodb://localhost:27017/gmp-dev
MONGO_PROD=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
MONGODB_URI=mongodb://localhost:27017/gmp-dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
SECRET_TOKEN=<replace-with-local-development-secret>
JWT_SECRET=<replace-with-jwt-secret-minimum-32-chars>
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=<replace-with-refresh-token-secret-minimum-32-chars>
JWT_REFRESH_EXPIRATION=604800

# GraphQL
GRAPHQL_DEBUG=true
GRAPHQL_PLAYGROUND=true

# Logging
LOG_LEVEL=debug
