# =============================================================================
# GMP SERVER — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT_API=3007
PORT_BATCH=4000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local Docker (matches docker-compose.yml defaults)
MONGO_DEV=mongodb://admin:password@localhost:27017/gmp-dev?authSource=admin

# Production replica set URI
MONGO_PROD=mongodb+srv://username:password@cluster.mongodb.net/gmp-prod?retryWrites=true&w=majority

# Fallback used when MONGO_DEV/MONGO_PROD is not set
MONGODB_URI=mongodb://admin:password@localhost:27017/gmp-dev?authSource=admin

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_TOKEN=change-me-to-a-random-64-char-hex-string
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRATION=3600

JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-hex-string
JWT_REFRESH_EXPIRATION=604800

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Initial Admin Seed ──────────────────────────────────────────────────────
# Used by bootstrap/admin seed flows when enabled
ADMIN_EMAIL=admin@gmp.com
ADMIN_PASSWORD=change-me-before-production

# ─── AI Live Chat Optional ───────────────────────────────────────────────────
# Leave empty to disable AI fallback replies
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── Social Login (OAuth) ────────────────────────────────────────────────────
# See SETUP.md for step-by-step provider registration instructions.
# Leave a provider's CLIENT_ID empty to disable that provider (returns 503).

# Public base URL of this API (used to build default callback URLs)
API_URL=http://localhost:3007
# Frontend URL users are redirected back to after the OAuth dance
FRONTEND_URL=http://localhost:3000
# Secret for signing the OAuth `state` param (falls back to SECRET_TOKEN/JWT_SECRET)
OAUTH_STATE_SECRET=

# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to ${API_URL}/auth/google/callback
GOOGLE_CALLBACK_URL=

# Kakao — https://developers.kakao.com
KAKAO_CLIENT_ID=
# Optional: only if "Client Secret" is enabled in the Kakao console
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=

# Naver — https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=
